# SkillForge backend — copy to .env and fill in secrets.
# NEVER commit a real .env file.

# Required: 64+ hex chars. Generate with:
#   python -c 'import secrets;print(secrets.token_hex(32))'
SECRET_KEY=

# Database (SQLite default for local dev)
DATABASE_URL=sqlite:///./skillforge.db

# Password reset email (Resend)
# Get a key at https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=
# PROJECT email address — user-facing mail comes from here, never personal
FROM_EMAIL=noreply@skillforge.app
# Used to build the reset link: {FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=http://localhost:5173

# Google OAuth (optional until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Code execution engine
CODE_ENGINE_URL=http://localhost:8028
