+def _login_allowed(request: Request, email: str) -> bool:
+    import time
+    ip = request.client.host if request.client else "?"
+    key = f"{ip}|{email.strip().lower()}"
+    now = time.monotonic()
+    hits = [t for t in _LOGIN_ATTEMPTS.get(key, []) if now - t < _LOGIN_WINDOW_S]
