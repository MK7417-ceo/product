diff --git a/part-1-core/app/adapters/outbound/search_repository.py b/part-1-core/app/adapters/outbound/search_repository.py
new file mode 100644
index 0000000..5677d66
--- /dev/null
+++ b/part-1-core/app/adapters/outbound/search_repository.py
@@ -0,0 +1,126 @@
+"""Outbound adapter: global search repository (SQLAlchemy).
+
+One query per content type, always scoped to the requesting user —
+like Apple Notes never surfacing another person's locked notes,
+a user only ever searches their own content.
+"""
+from __future__ import annotations
+
+from typing import Callable
+
+from sqlalchemy import or_
+from sqlalchemy.orm import Session
+
+from app.adapters.outbound.models import (
+    AssessmentModel,
+    CertificateModel,
+    EvidenceModel,
+    RoadmapModel,
+    RoadmapTaskModel,
+)
+
+
+def _escape_like(term: str) -> str:
+    return term.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+
+
+def _like(col, term: str):
+    return col.ilike(f"%{_escape_like(term)}%", escape="\\")
+
+
+class SqlAlchemySearchRepository:
+    def __init__(self, session_factory: Callable[[], Session]) -> None:
+        self._sessions = session_factory
+
+    def _clauses(self, cols, terms):
+        return [or_(*(_like(c, t) for c in cols)) for t in terms]
+
+    def search(self, user_id: str, terms: list[str],
+               types: tuple[str, ...]) -> list[dict]:
+        """Raw candidates: [{type, id, title, body, created_at}]."""
+        out: list[dict] = []
+        with self._sessions() as s:
+            if "roadmap" in types:
+                cols = [RoadmapModel.title]
+                q = (
+                    s.query(RoadmapModel)
+                    .filter(RoadmapModel.user_id == user_id)
+                    .filter(or_(*self._clauses(cols, terms)))
+                )
+                for m in q.all():
+                    out.append({
+                        "type": "roadmap", "id": m.id,
+                        "title": m.title, "body": f"{m.title} · v{m.version} · {m.source}",
+                        "created_at": m.created_at,
+                    })
+            if "task" in types:
+                cols = [
+                    RoadmapTaskModel.title, RoadmapTaskModel.description,
+                    RoadmapTaskModel.why_it_matters, RoadmapTaskModel.target_skills,
+                    RoadmapTaskModel.expected_evidence,
+                    RoadmapTaskModel.acceptance_criteria,
+                ]
+                q = (
+                    s.query(RoadmapTaskModel)
+                    .join(RoadmapModel,
+                          RoadmapTaskModel.roadmap_id == RoadmapModel.id)
+                    .filter(RoadmapModel.user_id == user_id)
+                    .filter(or_(*self._clauses(cols, terms)))
+                )
+                for m in q.all():
+                    out.append({
+                        "type": "task", "id": m.task_key,
+                        "title": m.title,
+                        "body": " ".join([
+                            m.description, m.why_it_matters,
+                            m.target_skills, m.expected_evidence,
+                            m.acceptance_criteria, m.status, m.priority,
+                        ]),
+                        "created_at": m.created_at,
+                    })
+            if "evidence" in types:
+                cols = [EvidenceModel.content, EvidenceModel.feedback,
+                        EvidenceModel.kind]
+                q = (
+                    s.query(EvidenceModel)
+                    .filter(EvidenceModel.user_id == user_id)
+                    .filter(or_(*self._clauses(cols, terms)))
+                )
+                for m in q.all():
+                    out.append({
+                        "type": "evidence", "id": m.id,
+                        "title": f"{m.kind} evidence · {m.task_key}",
+                        "body": f"{m.content} {m.feedback}",
+                        "created_at": m.created_at,
+                    })
+            if "assessment" in types:
+                cols = [AssessmentModel.topic, AssessmentModel.level,
+                        AssessmentModel.gaps]
+                q = (
+                    s.query(AssessmentModel)
+                    .filter(AssessmentModel.user_id == user_id)
+                    .filter(or_(*self._clauses(cols, terms)))
+                )
+                for m in q.all():
+                    out.append({
+                        "type": "assessment", "id": m.id,
+                        "title": f"{m.topic} · {m.level}",
+                        "body": f"{m.topic} {m.level} {m.status} gaps: {m.gaps}",
+                        "created_at": m.created_at,
+                    })
+            if "certificate" in types:
+                cols = [CertificateModel.title, CertificateModel.detail,
+                        CertificateModel.kind]
+                q = (
+                    s.query(CertificateModel)
+                    .filter(CertificateModel.user_id == user_id)
+                    .filter(or_(*self._clauses(cols, terms)))
+                )
+                for m in q.all():
+                    out.append({
+                        "type": "certificate", "id": m.id,
+                        "title": m.title,
+                        "body": f"{m.kind} {m.detail} {m.ref_id}",
+                        "created_at": m.created_at,
+                    })
+        return out
diff --git a/part-1-core/app/api/v1/ai.py b/part-1-core/app/api/v1/ai.py
new file mode 100644
index 0000000..3cfab54
--- /dev/null
+++ b/part-1-core/app/api/v1/ai.py
@@ -0,0 +1,94 @@
+"""Inbound adapter (HTTP): DB-first doubt solver + admin review queue.
+
+Endpoints:
+  POST /ai/doubt              — ask a question (auth required)
+  GET  /ai/status             — provider/llm-configured status (auth, no secrets)
+  GET  /ai/pending            — pending LLM answers awaiting review (admin)
+  POST /ai/pending/{id}/approve — approve -> becomes a served DB answer (admin)
+  POST /ai/pending/{id}/reject  — reject -> never served (admin)
+"""
+from __future__ import annotations
+
+from fastapi import APIRouter, Depends, Request
+from pydantic import BaseModel, Field
+
+from app.api.v1.auth import _domain_error, current_user_id, require_admin
+from app.domain.user import DomainError
+
+router = APIRouter(prefix="", tags=["ai"])
+
+
+def _svc(request: Request):
+    return request.app.state.ai_answer_service
+
+
+class DoubtRequest(BaseModel):
+    question: str = Field(min_length=1, max_length=1000)
+    topic_slug: str = Field(default="", max_length=80)
+
+
+def _answer_dict(a) -> dict:
+    return {
+        "id": a.id, "question": a.question, "answer": a.answer,
+        "source": a.source, "status": a.status,
+        "topic_slug": a.topic_slug, "created_by": a.created_by,
+        "approved_by": a.approved_by,
+    }
+
+
+def _ask_dict(r) -> dict:
+    return {
+        "answer": r.answer, "source": r.source,
+        "confidence": r.confidence, "validated": r.validated,
+        "llm_called": r.llm_called, "llm_configured": r.llm_configured,
+        "answer_id": r.answer_id,
+        "citations": [{"topic_slug": c.topic_slug, "title": c.title}
+                      for c in r.citations],
+    }
+
+
+@router.post("/ai/doubt")
+def ask_doubt(body: DoubtRequest, request: Request,
+              user_id: str = Depends(current_user_id)):
+    try:
+        result = _svc(request).ask(user_id, body.question, body.topic_slug)
+    except DomainError as exc:
+        raise _domain_error(exc)
+    return _ask_dict(result)
+
+
+@router.get("/ai/status")
+def ai_status(request: Request, user_id: str = Depends(current_user_id)):
+    svc = _svc(request)
+    return {
+        "provider": svc.provider_name,
+        "llm_configured": svc.llm_configured,
+        "db_first": True,
+        "note": ("LLM answers are stored as pending and served as DB "
+                 "answers only after admin approval."),
+    }
