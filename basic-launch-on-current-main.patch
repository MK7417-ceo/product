+  padding: 16px 20px; margin-bottom: 8px;
+}
+.rj-summary-route { display: flex; align-items: center; gap: 12px; }
+.rj-pin { font-size: 24px; }
+.rj-summary-route b { display: block; font-size: 16px; }
+.rj-summary-route span { font-size: 13px; color: var(--muted); }
+.rj-progress { display: flex; align-items: center; gap: 10px; min-width: 180px; }
