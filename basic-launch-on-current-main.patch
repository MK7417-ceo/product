@@ -0,0 +1,98 @@
+/* Learn page — topics grid + theory reading */
+.learn-wrap {
+  max-width: 860px;
+  margin: 0 auto;
+  padding: 24px 20px 48px;
+}
+.learn-head h1 {
+  font-size: 26px;
+  margin: 0 0 6px;
+}
+.learn-muted {
+  color: var(--muted, #A79B8E);
+  font-size: 14px;
+}
+.learn-error {
+  color: #E05D44;
+  background: rgba(224, 93, 68, 0.1);
+  border: 1px solid rgba(224, 93, 68, 0.3);
+  padding: 12px 16px;
+  border-radius: 10px;
+}
+.learn-back {
+  background: none;
+  border: none;
+  color: var(--accent, #E85D26);
+  font-size: 14px;
+  cursor: pointer;
+  padding: 0;
+  margin-bottom: 12px;
+}
+.learn-back:hover { text-decoration: underline; }
+
+.learn-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
+  gap: 14px;
+  margin-top: 20px;
+}
+.learn-topic-card {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  gap: 6px;
+  text-align: left;
+  background: rgba(247, 241, 232, 0.03);
+  border: 1px solid rgba(247, 241, 232, 0.1);
+  border-top: 3px solid var(--topic-color, #E85D26);
+  border-radius: 12px;
+  padding: 18px;
+  cursor: pointer;
+  color: inherit;
+  font: inherit;
+  transition: transform 0.15s, border-color 0.15s;
+}
+.learn-topic-card:hover {
+  transform: translateY(-2px);
+  border-color: var(--topic-color, #E85D26);
+}
+.learn-topic-icon { font-size: 28px; }
+.learn-topic-name { font-size: 16px; font-weight: 700; }
+.learn-topic-desc {
+  font-size: 13px;
+  color: var(--muted, #A79B8E);
+  line-height: 1.5;
+}
+.learn-topic-cta {
+  margin-top: 8px;
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--accent, #E85D26);
+}
+
+.learn-filters {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+  margin: 16px 0 20px;
+}
+.learn-chip {
+  background: rgba(247, 241, 232, 0.05);
+  border: 1px solid rgba(247, 241, 232, 0.12);
+  color: var(--muted, #A79B8E);
+  border-radius: 99px;
+  padding: 6px 14px;
+  font-size: 13px;
+  cursor: pointer;
+}
+.learn-chip.active {
+  background: rgba(232, 93, 38, 0.2);
+  border-color: var(--accent, #E85D26);
+  color: #F5EFE6;
+}
+
+.learn-blocks {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+}
diff --git a/part-1-core/frontend/src/pages/Learn.tsx b/part-1-core/frontend/src/pages/Learn.tsx
new file mode 100644
index 0000000..bda7069
--- /dev/null
+++ b/part-1-core/frontend/src/pages/Learn.tsx
@@ -0,0 +1,153 @@
+import { useCallback, useEffect, useState } from 'react';
+import { useNavigate, useParams } from 'react-router-dom';
+import { api } from '../lib/api';
+import TheoryCard from '../components/visual/TheoryCard';
+import './Learn.css';
+
+interface Topic {
+  slug: string;
+  name: string;
+  description: string;
+  icon: string;
+  color: string;
+  active: boolean;
+  theory_count?: number;
+}
+
+interface TheoryBlock {
+  id: string;
+  topic_slug: string;
+  title: string;
+  level: string;
+  content: string;
+  order_index: number;
+}
+
+const LEVEL_LABEL: Record<string, string> = {
+  beginner: '🌱 Beginner',
+  intermediate: '🌿 Intermediate',
+  advanced: '🌳 Advanced',
+  expert: '🔥 Expert',
+};
+
+function TopicList() {
+  const navigate = useNavigate();
+  const [topics, setTopics] = useState<Topic[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+
+  useEffect(() => {
+    (async () => {
+      try {
+        const r = await api<{ topics: Topic[] }>('/api/v1/content/topics');
+        // Hide topics with no theory content — don't promise what isn't there.
+        setTopics(r.topics.filter((t) => (t.theory_count ?? 0) > 0));
+      } catch (e) {
+        setError(e instanceof Error ? e.message : 'Failed to load topics');
+      } finally {
+        setLoading(false);
+      }
+    })();
+  }, []);
+
+  if (loading) return <div className="learn-wrap"><p className="learn-muted">Loading topics…</p></div>;
+  if (error) return <div className="learn-wrap"><p className="learn-error">{error}</p></div>;
+
+  return (
+    <div className="learn-wrap">
+      <header className="learn-head">
+        <h1>📖 Learn</h1>
+        <p className="learn-muted">Pick a topic, read the theory, then practice it.</p>
+      </header>
+      {topics.length === 0 ? (
+        <p className="learn-muted">No topics yet — check back soon.</p>
+      ) : (
+        <div className="learn-grid">
+          {topics.map((t) => (
+            <button
+              key={t.slug}
+              className="learn-topic-card"
+              style={{ ['--topic-color' as string]: t.color || '#E85D26' }}
+              onClick={() => navigate(`/learn/${t.slug}`)}
+            >
+              <span className="learn-topic-icon">{t.icon || '📘'}</span>
+              <span className="learn-topic-name">{t.name}</span>
+              {t.description && <span className="learn-topic-desc">{t.description}</span>}
+              <span className="learn-topic-cta">Read →</span>
+            </button>
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
+
+function TopicDetail() {
+  const { slug } = useParams<{ slug: string }>();
+  const navigate = useNavigate();
+  const [topic, setTopic] = useState<Topic | null>(null);
+  const [blocks, setBlocks] = useState<TheoryBlock[]>([]);
+  const [level, setLevel] = useState('');
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState('');
+
+  const load = useCallback(async (lv: string) => {
+    if (!slug) return;
+    setLoading(true);
+    setError('');
+    try {
+      const [t, b] = await Promise.all([
+        api<Topic>(`/api/v1/content/topics/${slug}`),
+        api<{ theory: TheoryBlock[] }>(
+          `/api/v1/content/topics/${slug}/theory${lv ? `?level=${lv}` : ''}`
+        ),
+      ]);
+      setTopic(t);
+      setBlocks(b.theory);
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'Failed to load content');
+    } finally {
+      setLoading(false);
+    }
+  }, [slug]);
+
+  useEffect(() => { load(level); }, [load, level]);
+
+  if (loading) return <div className="learn-wrap"><p className="learn-muted">Loading…</p></div>;
+  if (error) return <div className="learn-wrap"><p className="learn-error">{error}</p></div>;
+
+  return (
+    <div className="learn-wrap">
+      <button className="learn-back" onClick={() => navigate('/learn')}>← All topics</button>
+      <header className="learn-head">
+        <h1>{topic?.icon} {topic?.name}</h1>
+        {topic?.description && <p className="learn-muted">{topic.description}</p>}
+      </header>
+      <div className="learn-filters">
+        {['', 'beginner', 'intermediate', 'advanced', 'expert'].map((lv) => (
+          <button
+            key={lv || 'all'}
+            className={`learn-chip${level === lv ? ' active' : ''}`}
+            onClick={() => setLevel(lv)}
+          >
+            {lv === '' ? 'All levels' : LEVEL_LABEL[lv]}
+          </button>
+        ))}
+      </div>
+      {blocks.length === 0 ? (
+        <p className="learn-muted">No theory blocks here yet.</p>
+      ) : (
+        <div className="learn-blocks">
+          {blocks.map((b) => (
+            <TheoryCard key={b.id} title={b.title} content={b.content} />
+          ))}
+        </div>
+      )}
+    </div>
+  );
+}
+
+export default function Learn() {
+  const { slug } = useParams<{ slug: string }>();
+  return slug ? <TopicDetail /> : <TopicList />;
+}
