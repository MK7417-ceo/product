+++ b/part-1-core/frontend/src/components/RoadmapJourney.tsx
@@ -0,0 +1,94 @@
+import type { RoadmapTask } from '../lib/p1api';
+import './RoadmapJourney.css';
+
+/* Roadmap rendered as a navigation journey — Google Maps style.
+   A vertical route connects waypoints: visited (green ✓), current
+   position (pulsing accent "YOU ARE HERE"), and upcoming stops (numbered).
+   Tapping a waypoint opens its details. */
+
+const PRI_CLASS: Record<string, string> = {
+  high: 'warn', medium: 'info', low: 'claim',
+};
+
+interface Props {
+  tasks: RoadmapTask[];
+  onSelect: (t: RoadmapTask) => void;
+}
+
+export default function RoadmapJourney({ tasks, onSelect }: Props) {
+  const completed = tasks.filter((t) => t.status === 'completed').length;
+  const totalMin = tasks.reduce((s, t) => s + (t.effort_minutes || 0), 0);
+  const pct = tasks.length ? Math.round((100 * completed) / tasks.length) : 0;
+
+  // Current position: first in_progress, else first pending
+  const currentIdx = (() => {
+    const ip = tasks.findIndex((t) => t.status === 'in_progress');
+    if (ip >= 0) return ip;
+    return tasks.findIndex((t) => t.status !== 'completed');
+  })();
+
+  return (
+    <div className="rj">
+      <div className="rj-summary">
+        <div className="rj-summary-route">
+          <span className="rj-pin">📍</span>
+          <div>
+            <b>Your learning route</b>
+            <span>
+              {tasks.length} stops · {totalMin} min total · {completed} visited
+            </span>
+          </div>
+        </div>
+        <div className="rj-progress">
+          <div className="rj-bar"><i style={{ width: `${pct}%` }} /></div>
+          <span>{pct}%</span>
+        </div>
+      </div>
+
+      <div className="rj-route">
+        {tasks.map((t, i) => {
+          const done = t.status === 'completed';
+          const current = i === currentIdx;
+          return (
+            <div key={t.id} className={`rj-stop${done ? ' done' : ''}${current ? ' current' : ''}`}>
+              <div className="rj-rail">
+                <button
+                  className="rj-marker"
+                  onClick={() => onSelect(t)}
+                  aria-label={`${done ? 'Visited' : current ? 'Current position' : `Stop ${i + 1}`}: ${t.title}`}
+                >
+                  {done ? '✓' : current ? '' : i + 1}
+                </button>
+                {i < tasks.length - 1 && <span className="rj-line" />}
+              </div>
+              <button className="rj-card" onClick={() => onSelect(t)}>
+                {current && !done && <span className="rj-you">YOU ARE HERE</span>}
+                <div className="rj-title">{t.title}</div>
+                {t.why_it_matters && <div className="rj-why">{t.why_it_matters}</div>}
+                <div className="rj-meta">
+                  {t.effort_minutes > 0 && <span>⏱ {t.effort_minutes} min</span>}
+                  {t.target_skills?.length > 0 && <span>🎯 {t.target_skills.slice(0, 3).join(', ')}</span>}
+                </div>
+                <div className="rj-tags">
+                  <span className={`p1x-pill ${PRI_CLASS[t.priority] ?? 'claim'}`}>
+                    {t.priority.toUpperCase()}
+                  </span>
+                  <span className={`p1x-pill ${done ? 'ok' : current ? 'info' : 'claim'}`}>
+                    {done ? 'VISITED' : current ? 'NAVIGATING' : t.status.replace('_', ' ').toUpperCase()}
+                  </span>
+                </div>
+              </button>
+            </div>
+          );
+        })}
+      </div>
+
+      {tasks.length > 0 && (
+        <div className="rj-destination">
+          <span className="rj-pin">🏁</span>
+          <span>Destination: job-ready engineer. Completed work is never lost — the route adapts, history stays.</span>
+        </div>
+      )}
+    </div>
+  );
+}
diff --git a/part-1-core/frontend/src/components/SearchBar.tsx b/part-1-core/frontend/src/components/SearchBar.tsx
new file mode 100644
index 0000000..260a0cc
--- /dev/null
+++ b/part-1-core/frontend/src/components/SearchBar.tsx
@@ -0,0 +1,162 @@
+import { useEffect, useRef, useState } from 'react';
+import { api } from '../lib/api';
+
+/* Global search — modelled on Apple Notes search:
+   one field, live results as you type, type-filter chips (like Notes'
+   suggested searches such as "Notes with Drawings"), and a snippet that
+   shows the matched text in context. Only the signed-in user's own
+   content is ever searched (like locked notes staying private). */
+
+export type SearchType = 'roadmap' | 'task' | 'evidence' | 'assessment' | 'certificate';
+
+export interface SearchResultItem {
+  type: SearchType;
+  id: string;
+  title: string;
+  snippet: string; // HTML with <mark> around matches — rendered via dangerouslySetInnerHTML
+  score: number;
+  created_at: string;
+}
+
+const FILTERS: Array<{ key: SearchType | 'all'; label: string }> = [
+  { key: 'all', label: 'All' },
+  { key: 'roadmap', label: 'Roadmaps' },
+  { key: 'task', label: 'Tasks' },
+  { key: 'evidence', label: 'Evidence' },
+  { key: 'assessment', label: 'Assessments' },
+  { key: 'certificate', label: 'Certificates' },
+];
+
+const TYPE_LABEL: Record<SearchType, string> = {
+  roadmap: 'Roadmap',
+  task: 'Task',
+  evidence: 'Evidence',
+  assessment: 'Assessment',
+  certificate: 'Certificate',
+};
+
+export default function SearchBar() {
+  const [query, setQuery] = useState('');
+  const [filter, setFilter] = useState<SearchType | 'all'>('all');
+  const [results, setResults] = useState<SearchResultItem[]>([]);
+  const [open, setOpen] = useState(false);
+  const [loading, setLoading] = useState(false);
+  const boxRef = useRef<HTMLDivElement>(null);
+  const debounceRef = useRef<number | undefined>(undefined);
+
+  useEffect(() => {
+    const onDocClick = (e: MouseEvent) => {
+      if (boxRef.current && !boxRef.current.contains(e.target as Node)) setOpen(false);
+    };
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') setOpen(false);
+    };
+    document.addEventListener('mousedown', onDocClick);
+    document.addEventListener('keydown', onKey);
+    return () => {
+      document.removeEventListener('mousedown', onDocClick);
+      document.removeEventListener('keydown', onKey);
+    };
+  }, []);
+
+  const onQueryChange = (value: string) => {
+    setQuery(value);
+    if (value.trim().length < 2) {
+      window.clearTimeout(debounceRef.current);
+      setResults([]);
+      setLoading(false);
+      setOpen(false);
+    }
+  };
+
+  useEffect(() => {
+    const q = query.trim();
+    if (q.length < 2) return;
+    debounceRef.current = window.setTimeout(async () => {
+      setLoading(true);
+      try {
+        const params = new URLSearchParams({ q, limit: '12' });
+        if (filter !== 'all') params.set('types', filter);
+        const data = await api<{ results: SearchResultItem[] }>(
+          `/api/v1/search?${params.toString()}`,
+        );
+        setResults(data.results);
+        setOpen(true);
+      } catch {
+        setResults([]);
+      } finally {
+        setLoading(false);
+      }
+    }, 250);
+    return () => window.clearTimeout(debounceRef.current);
+  }, [query, filter]);
+
+  return (
+    <div className="sf-search" ref={boxRef}>
+      <div className="sf-search-field">
+        <span className="sf-search-icon" aria-hidden>⌕</span>
+        <input
+          value={query}
+          onChange={(e) => onQueryChange(e.target.value)}
+          onFocus={() => query.trim().length >= 2 && setOpen(true)}
+          placeholder="Search roadmaps, tasks, evidence…"
+          aria-label="Global search"
+        />
+        {loading && <span className="sf-search-spinner" aria-hidden />}
+        {query && (
+          <button
+            className="sf-search-clear"
+            onClick={() => {
+              setQuery('');
+              setResults([]);
+            }}
+            aria-label="Clear search"
+          >
+            ×
+          </button>
+        )}
+      </div>
+
+      {open && query.trim().length >= 2 && (
+        <div className="sf-search-pop">
+          <div className="sf-search-filters" role="tablist" aria-label="Result type filter">
+            {FILTERS.map((f) => (
+              <button
+                key={f.key}
+                role="tab"
+                aria-selected={filter === f.key}
+                className={filter === f.key ? 'active' : ''}
+                onClick={() => setFilter(f.key)}
+              >
+                {f.label}
+              </button>
+            ))}
+          </div>
+
+          <div className="sf-search-results">
+            {!loading && results.length === 0 && (
+              <div className="sf-search-empty">No matches for “{query.trim()}”.</div>
+            )}
+            {results.map((r) => (
+              <div key={`${r.type}:${r.id}`} className="sf-search-hit">
+                <span className={`sf-search-tag tag-${r.type}`}>{TYPE_LABEL[r.type]}</span>
+                <div className="sf-search-hit-body">
+                  <div
+                    className="sf-search-hit-title"
+                    dangerouslySetInnerHTML={{ __html: r.title }}
+                  />
+                  {r.snippet && (
+                    <div
+                      className="sf-search-hit-snippet"
+                      dangerouslySetInnerHTML={{ __html: r.snippet }}
+                    />
+                  )}
+                </div>
+              </div>
+            ))}
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
